<Window x:Class="SkillPalette_Windows.PaletteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Skill Palette">
  <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
  <Grid Padding="18" RowSpacing="12" PreviewKeyDown="Root_PreviewKeyDown" KeyDown="Root_KeyDown">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal" Spacing="10"><Border Width="24" Height="24" CornerRadius="6"><Image Source="Assets/SkillPaletteIcon.png" Stretch="Uniform" AutomationProperties.Name="Skill Palette 图标"/></Border><TextBlock Text="Skill Palette" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="搜索技能、描述或标签…" TextChanged="SearchBox_TextChanged" PreviewKeyDown="PaletteControl_PreviewKeyDown" />
    <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryBox" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed" IsTabStop="False" PreviewKeyDown="PaletteControl_PreviewKeyDown"/><ToggleButton x:Name="FavoritesButton" Grid.Column="1" Checked="Filter_Changed" Unchecked="Filter_Changed" IsTabStop="False" PreviewKeyDown="PaletteControl_PreviewKeyDown"><StackPanel Orientation="Horizontal" Spacing="5"><SymbolIcon Symbol="OutlineStar"/><TextBlock Text="收藏"/></StackPanel></ToggleButton><TextBlock Grid.Column="2" Text="最近使用优先" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <ListView x:Name="ResultList" Grid.Row="3" ItemsSource="{x:Bind Items}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ResultList_ItemClick"><ListView.ItemTemplate><DataTemplate><Grid Padding="10,9" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Tag="{Binding}" Click="Star_Click" Width="32" Height="32" Padding="0"><SymbolIcon Symbol="{Binding Star}"/></Button></Grid></DataTemplate></ListView.ItemTemplate></ListView>
    <Grid Grid.Row="4"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="↑↓ 选择" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Enter 插入" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="Esc 取消" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock x:Name="SelectionText" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
  </Grid>
</Window>
