<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SkillPalette_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="SettingsNavigation"
                    PaneDisplayMode="Auto"
                    IsPaneToggleButtonVisible="False"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    OpenPaneLength="248"
                    CompactPaneLength="56"
                    SelectionChanged="SettingsNavigation_SelectionChanged">
        <NavigationView.PaneHeader>
            <StackPanel Margin="0,4,0,12" Spacing="4">
                <TextBlock Text="Skill Palette" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="设置中心" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="常规" Tag="General">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Skill 库" Tag="Skills" IsSelected="True">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="目标应用" Tag="Targets">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Preview" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="诊断" Tag="Diagnostics">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="关于" Tag="About">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <ScrollViewer x:Name="SkillLibraryContent" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,36,32,48" MaxWidth="1024" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Skill 库" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="管理从本地目录发现的 Skills、标签和收藏。"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar x:Name="ScanStatus" IsOpen="True" Severity="Informational"
                             Title="正在准备本地 Skill 索引。" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 PlaceholderText="搜索 Skill 库"
                                 AutomationProperties.Name="搜索 Skill 库"
                                 TextChanged="SearchBox_TextChanged" />
                        <Button Grid.Column="1" Content="重新扫描" Click="RescanButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="重新扫描本地 Skill 库" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="CategoryFilter" Width="176" ItemsSource="{x:Bind Categories}"
                                  SelectedIndex="0" SelectionChanged="CategoryFilter_SelectionChanged"
                                  AutomationProperties.Name="按父级 Skill 分类筛选" />
                        <ToggleButton x:Name="FavoriteFilterButton" Checked="FavoriteFilter_Changed" Unchecked="FavoriteFilter_Changed"
                                      AutomationProperties.Name="仅显示收藏的 Skills">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Favorite" />
                                <TextBlock Text="收藏" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="描述" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                <TextBlock Grid.Column="2" Text="分类" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                            </Grid>

                            <ListView x:Name="SkillList" Grid.Row="1" ItemsSource="{x:Bind Skills}"
                                      SelectionMode="None" IsItemClickEnabled="False" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="20,14" MinHeight="74">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.05*" />
                                                <ColumnDefinition Width="1.55*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding RelativePath}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    Padding="10,4" CornerRadius="12"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding Family}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Button Grid.Column="3" Tag="{Binding}" Click="FavoriteItemButton_Click"
                                                    Width="36" Height="36" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    AutomationProperties.Name="{Binding FavoriteAutomationName}">
                                                <SymbolIcon Symbol="{Binding FavoriteIcon}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.Footer>
                                    <TextBlock x:Name="EmptyState" Padding="20,28" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ListView.Footer>
                            </ListView>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ScanSummary" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GeneralContent" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,36,32,48" MaxWidth="720" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="常规" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="控制触发字符、Skill 调用前缀和全局监听状态。设置保存在本机并立即生效。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar x:Name="GeneralStatus" IsOpen="True" Severity="Informational"
                             Title="监听器正在准备" />

                    <Grid ColumnSpacing="32" RowSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="触发字符" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="用于打开 Skill Palette。" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBox x:Name="TriggerCharacterBox" Width="280" HorizontalAlignment="Left" MaxLength="1" PlaceholderText="#"
                                     LostFocus="TriggerCharacterBox_LostFocus"
                                     AutomationProperties.Name="触发字符" />
                            <TextBlock Text="只能使用一个非空白的可打印字符；在已配置目标应用中输入后打开面板。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="调用前缀" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="插入 Skill 调用时使用。" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                            <TextBox x:Name="InvocationPrefixBox" Width="280" HorizontalAlignment="Left" PlaceholderText="@"
                                     LostFocus="InvocationPrefixBox_LostFocus"
                                     AutomationProperties.Name="Skill 调用前缀" />
                            <TextBlock Text="选择 Skill 后，会插入“调用前缀 + Skill 名称 + 空格”。"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="启用全局监听" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="软件运行时自动开启。" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
                            <ToggleSwitch x:Name="ListeningEnabledSwitch" OnContent="正在监听" OffContent="已暂停"
                                          Toggled="ListeningEnabledSwitch_Toggled"
                                          AutomationProperties.Name="启用全局监听" />
                            <TextBlock Text="开启后，可在已添加的应用中输入触发字符来打开技能面板。此功能仅在本机运行，不会收集或上传您的输入内容。关闭后不会打开面板，您可随时在这里重新开启。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Spacing="4">
                            <TextBlock Text="开机自动启动" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="登录 Windows 后自动在后台启动。" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8">
                            <ToggleSwitch x:Name="LaunchAtStartupSwitch" OnContent="已开启" OffContent="已关闭"
                                          Toggled="LaunchAtStartupSwitch_Toggled"
                                          AutomationProperties.Name="开机自动启动" />
                            <TextBlock Text="启动后会驻留在系统托盘，并按您的监听设置运行。您可随时在这里关闭。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TargetApplicationsContent" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,36,32,48" MaxWidth="760" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="目标应用" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="仅在这里配置的前台应用中拦截触发字符。规则只保存在本机，并会立即生效。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar IsOpen="True" Severity="Informational" Title="按进程名识别"
                             Message="例如 Codex 对应 codex，ChatGPT 对应 chatgpt。可在任务管理器的“详细信息”中查看进程名。" />

                    <ToggleSwitch x:Name="TargetOnlyModeSwitch" Header="仅目标应用响应触发字符"
                                  OnContent="开启" OffContent="关闭" Toggled="TargetOnlyModeSwitch_Toggled"
                                  AutomationProperties.Name="仅目标应用响应触发字符" />

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel x:Name="TargetRulesPanel" Padding="16" Spacing="8" />
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="添加自定义应用" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewProcessNameBox" PlaceholderText="进程名，例如 notepad 或 my-editor.exe"
                                     AutomationProperties.Name="新目标应用进程名" />
                            <Button Grid.Column="1" Content="添加" Click="AddTargetRuleButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                        <TextBlock x:Name="TargetRulesSummary" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DiagnosticsContent" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,36,32,48" MaxWidth="760" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="诊断" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="查看本机运行状态，帮助排查触发、窗口焦点和回填问题。诊断摘要不会包含您的输入内容或 Skill 正文。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新状态" Click="RefreshDiagnosticsButton_Click" />
                        <Button Content="复制诊断摘要" Click="CopyDiagnosticsButton_Click" />
                    </StackPanel>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Padding="16" Spacing="14">
                            <StackPanel Spacing="3"><TextBlock Text="全局监听" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DiagnosticsListenerText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="前台应用" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DiagnosticsForegroundText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="目标规则" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DiagnosticsTargetsText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="最近一次会话" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DiagnosticsSessionText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="Skill 索引" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DiagnosticsCatalogText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </StackPanel>
                    </Border>
                    <InfoBar IsOpen="True" Severity="Informational" Title="隐私说明"
                             Message="复制的摘要仅包含运行状态、进程名称和计数，不包含您的输入、剪贴板内容、Skill 正文或绝对路径。" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutContent" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="32,36,32,48" MaxWidth="760" Spacing="20">
                    <StackPanel Spacing="6">
                        <TextBlock Text="关于" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="Skill Palette for Windows" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="一个用于搜索和调用本地 Codex Skills 的轻量 Windows 工具。"
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Padding="16" Spacing="12">
                            <StackPanel Spacing="3"><TextBlock Text="开发者" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="Jiawei Jiang" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="隐私" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="Skill Palette 在本机处理 Skill 索引与搜索，不会上传您的 Skill 内容、搜索词或键盘输入。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="项目主页" Style="{ThemeResource SubtitleTextBlockStyle}" /><HyperlinkButton Content="github.com/weiweidounai0131/skill-palette" NavigateUri="https://github.com/weiweidounai0131/skill-palette" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Spacing="3"><TextBlock Text="当前版本" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="1.2.0 · Windows x64 便携版" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                        </StackPanel>
                    </Border>

                    <InfoBar IsOpen="True" Severity="Informational" Title="项目主页"
                             Message="本 Windows 版本遵循原项目的本地搜索、分类、收藏与调用工作流，并采用 Windows 原生界面与交互。" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="PlaceholderContent" Margin="48,36" MaxWidth="720" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="PlaceholderTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PlaceholderDescription" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar IsOpen="True" Severity="Informational" Title="该页面将在后续功能阶段实现。"
                         Message="设置中心的视觉与导航已固定；当前先完成 Skill 库。" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Page>
